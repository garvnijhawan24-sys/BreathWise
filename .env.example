# BreatheWise environment template
# Copy to .env for local development. Never commit .env or paste real secrets into AI prompts.

APP_ENV=development
APP_NAME=BreatheWise
LOG_LEVEL=INFO

# FastAPI
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated list; use exact frontend origins in production.
CORS_ORIGINS=http://localhost:5173

# Open-Meteo Air Quality API (standard public API generally does not require a key)
OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# OpenAQ API v3 (add a key only if required by the endpoints you use)
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# Optional PostgreSQL/Supabase persistence
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. NEVER expose this through a VITE_* variable or frontend bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Optional cache
REDIS_URL=

# ML inference
MODEL_PATH=backend/models/air_quality_model.joblib
ML_MODEL_ENABLED=false

# Public frontend config only; VITE_* values are bundled into client code.
VITE_API_BASE_URL=http://localhost:8000
