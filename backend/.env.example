# BreatheWise Backend Environment Template
# Copy to .env for local development.

APP_ENV=development
APP_NAME=BreatheWise
LOG_LEVEL=INFO

# FastAPI
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Open-Meteo Air Quality API (standard public API, no key required)
OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search

# OpenAQ API v3 (optional key for physical ground stations)
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# ML inference
MODEL_PATH=models/air_quality_model.joblib
ML_MODEL_ENABLED=true
